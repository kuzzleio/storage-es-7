// `bundler` honours `exports`, and @elastic/elasticsearch 7 exposes its type
// subpaths (`api/types`, `api/requestParams`) only through the folder mapping
// `"./": "./"`, which TypeScript does not support: `paths` maps them back.
{
  "compilerOptions": {
    "paths": {
      "@elastic/elasticsearch/*": ["./node_modules/@elastic/elasticsearch/*"]
    },
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["lib", "test/conformance.test.ts"]
}
